<Window x:Class="HolidayShowdown.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Holiday Showdown" Height="600" Width="900"
        Background="{StaticResource BrandBackground}">
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="{StaticResource BrandPrimary}" Padding="16,12">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="🎉 Holiday Showdown" FontSize="20" FontWeight="Bold" Foreground="White"/>
                <TextBlock Text="  —  Which country wins more days off?" FontSize="13"
                           Foreground="#DCEAF0" VerticalAlignment="Bottom" Margin="8,0,0,2"/>
                <Button Content="History" Click="GoHistory_Click" Margin="24,0,0,0"
                        Padding="10,4" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                <Button Content="New Compare" Click="GoCompare_Click" Margin="8,0,0,0"
                        Padding="10,4" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>
        <ContentControl x:Name="MainContent"/>
    </DockPanel>
</Window>