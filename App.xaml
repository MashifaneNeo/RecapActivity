<Application x:Class="HolidayShowdown.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <SolidColorBrush x:Key="BrandPrimary" Color="#2B6777"/>
        <SolidColorBrush x:Key="BrandAccent" Color="#C8D8E4"/>
        <SolidColorBrush x:Key="BrandBackground" Color="#F2F9FA"/>
        <SolidColorBrush x:Key="WinColor" Color="#2E7D32"/>
        <SolidColorBrush x:Key="LoseColor" Color="#B00020"/>
        <SolidColorBrush x:Key="TieColor" Color="#8A6D00"/>
    </Application.Resources>
</Application>